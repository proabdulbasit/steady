ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
# Browser-visible backend origin used by the existing frontend API clients.
NEXT_PUBLIC_BACKEND_URL=http://localhost:4000
# Server-side origin used for SSR blog, article, and sitemap requests.
BACKEND_URL=http://localhost:4000
# Public canonical origin used by the publishing system.
SITE_BASE_URL=https://worksteady.app
# Generate a long random value; GitHub Actions sends it to POST /api/blog/revalidate.
BLOG_REVALIDATE_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
