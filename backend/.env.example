# Automated integration sync (Phase 5 — daily briefing data pipeline)
# Set to true on the backend process that should run scheduled Square + QuickBooks sync.
INTEGRATIONS_SYNC_ENABLED=true
# Minutes between cycles (min 5, max 1440). Use 5 locally to verify the scheduler quickly.
INTEGRATIONS_SYNC_INTERVAL_MINUTES=30

# AI (daily briefing + CSV/photo document upload). Copy ANTHROPIC_API_KEY from repo root .env.local
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-6
# BRIEFING_AUTO_GENERATE_AFTER_SYNC=false
# BRIEFING_DELIVER_AFTER_SYNC=false

# Outcome Memory Loop — follow up after advice (default 14 days).
# For local testing, set minutes instead (e.g. 1) so the banner appears quickly:
# OUTCOME_FOLLOWUP_MINUTES=1
# OUTCOME_FOLLOWUP_DAYS=14
# OUTCOME_ALLOW_FORCE_DUE=true
# Daily follow-up emails (UTC hour, default 14 = 9am US Eastern)
# OUTCOME_FOLLOWUP_EMAIL_ENABLED=true
# OUTCOME_FOLLOWUP_EMAIL_HOUR_UTC=14

# Daily Pulse — POST /api/daily-pulse/seed-pattern allowed when not production, or:
# PULSE_ALLOW_SEED=true

# WorkSteady automated blog. Keep credentials in deployment secrets, never git.
# MONGODB_URI=mongodb+srv://USER:PASSWORD@HOST/
# MONGODB_DB=worksteady
# SITE_BASE_URL=https://worksteady.app
# GROQ_API_KEY=
# Optional separate key for the weekly research job:
# GROQ_WEEKLY_API_KEY=
# GROQ_RESEARCH_MODEL=groq/compound
# GROQ_CONTENT_MODEL=openai/gpt-oss-120b
# GROQ_FALLBACK_MODEL=openai/gpt-oss-20b
# REPLICATE_API_TOKEN=
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
# CONTENT_COUNT=3
# MAX_KEYWORD_OPPORTUNITIES=8
# BLOG_QUALITY_THRESHOLD=82
# DRY_RUN=0

# Scheduled daily email/push (UTC hour, default 14 = 9am US Eastern)
# BRIEFING_DELIVERY_ENABLED=true
# BRIEFING_DELIVERY_HOUR_UTC=14

# Web push — generate with: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@steady.local
