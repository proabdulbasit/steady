PORT=4000
# Base URL users open in the browser — used for password-reset links (must match your Next.js URL).
FRONTEND_URL=http://localhost:3000

# Mail: either SMTP_* below, or use Gmail-style EMAIL_USERNAME + EMAIL_FROM + EMAIL_PASS (see mail.js)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Steady <noreply@example.com>"
EMAIL_USERNAME=
EMAIL_FROM=
EMAIL_PASS=
# Reset link lifetime in milliseconds (default 1 hour).
PASSWORD_RESET_EXPIRES_MS=3600000

MONGODB_URI=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME
STRIPE_PRO_PRICE_ID=
STRIPE_BUSINESS_PRICE_ID=
JWT_SECRET=
ADMIN_EMAIL=
